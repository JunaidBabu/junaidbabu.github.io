---
import '../styles/global.css';
interface Props {
	title: string;
	description?: string;
	showAds?: boolean;
}

const { 
	title, 
	description = "Junaid Babu's interactive web application portfolio and engineering blog.",
	showAds = false 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
		
		<!-- Google Analytics -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-5ZVXJQXPM3"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-5ZVXJQXPM3');
		</script>

		{showAds && (
			<!-- AdSense Auto Ads (Only shown on allowed routes to prevent violations) -->
			<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1429840077890100" crossorigin="anonymous"></script>
		)}
	</head>
	<body class="font-body text-slate-600 bg-slate-50 antialiased flex flex-col min-h-screen">
		<!-- Navigation -->
		<nav class="bg-white border-b border-slate-200 sticky top-0 z-50">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between h-16 items-center">
					<div class="flex-shrink-0 flex items-center">
						<a href="/" class="font-sans font-bold text-xl tracking-tight text-slate-900">Junaid<span class="text-brand-600">Babu</span></a>
					</div>
					<div class="hidden md:flex space-x-8">
						<a href="/#portfolio" class="text-slate-600 hover:text-brand-600 font-medium transition-colors">Portfolio</a>
						<a href="/blog" class="text-slate-600 hover:text-brand-600 font-medium transition-colors">Blog</a>
						<a href="/#about" class="text-slate-600 hover:text-brand-600 font-medium transition-colors">About</a>
						<a href="/contact" class="text-slate-600 hover:text-brand-600 font-medium transition-colors">Contact</a>
					</div>
				</div>
			</div>
		</nav>

		<main class="flex-grow">
			<slot />
		</main>

		<!-- Footer -->
		<footer class="bg-slate-900 text-slate-400 py-12 border-t border-slate-800">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center">
				<div class="mb-6 md:mb-0">
					<span class="font-sans font-bold text-xl tracking-tight text-white">Junaid<span class="text-brand-500">Babu</span></span>
					<p class="text-sm mt-2">&copy; <span id="current-year"></span> Junaid Babu. All rights reserved.</p>
				</div>
				<div class="flex space-x-6 text-sm font-medium">
					<a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
					<a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
					<a href="/contact" class="hover:text-white transition-colors">Contact</a>
				</div>
			</div>
		</footer>

		<script is:inline>
			document.getElementById('current-year').textContent = new Date().getFullYear();
		</script>
	</body>
</html>
