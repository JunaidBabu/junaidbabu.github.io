---
import Layout from '../layouts/Layout.astro';
---

<Layout 
    title="Contact | Junaid Babu" 
    description="Get in touch for business propositions, engineering inquiries, or to discuss responsive web architecture and browser-based AI."
    showAds={false}
>
    <div class="max-w-4xl mx-auto px-4 py-16 w-full">
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 md:p-12 text-center max-w-2xl mx-auto">
            <h1 class="font-sans text-4xl font-extrabold text-slate-900 mb-4">Get in Touch</h1>
            <p class="text-slate-600 text-lg mb-8">Have a question about Phonics Buddy, a business proposition, or just want to chat about AI and React architecture?</p>
            
            <a href="https://in.linkedin.com/in/junaidbabu" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-[#0A66C2] text-white font-semibold px-8 py-4 rounded-xl hover:bg-[#004182] transition shadow-lg hover:shadow-xl">
                Connect on LinkedIn
            </a>

            <div class="mt-12 pt-8 border-t border-slate-100 flex flex-col items-center gap-4">
                <p class="text-slate-500 text-sm">Or find me wandering the digital landscapes of GitHub.</p>
                <a href="https://github.com/JunaidBabu" target="_blank" rel="noopener noreferrer" class="text-slate-700 font-medium hover:text-brand-600 transition">github.com/JunaidBabu</a>
            </div>
        </div>
    </div>
</Layout>
